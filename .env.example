# Every setting the server reads. Copy this to .env.local and fill in what you
# need — the server starts without any of it, and says on the way up what is
# and is not connected.
#
# Nothing here has a VITE_ prefix, so none of it is ever bundled into the
# browser. Keys and file paths stay on the server. Front-end settings live in
# .env instead, and those ARE public.

# ── Where it listens ────────────────────────────────────────────────────────
# NODE_ENV=production
# PORT=8080
# HOST=0.0.0.0
# LOG_LEVEL=info                 # debug | info | warn | error
# STATIC_DIR=dist                # the built front end this server also serves

# Only needed if the front end is deployed on a different origin to the API.
# Same-origin deployments — the default — need no CORS at all.
# CORS_ORIGINS=https://crm.example.com,https://admin.example.com

# ── Robi, the assistant ─────────────────────────────────────────────────────
# One key. With none, Robi still works and answers from the rules alone.
# A changed key takes effect on save, no restart; the server checks it with
# the provider and logs whether it was accepted.
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Defaults: gpt-4o-mini (OpenAI), openai/gpt-oss-120b (Groq) or claude-opus-5 (Claude).
# AI_MODEL=gpt-4o-mini
# AI_EFFORT=medium               # low | medium | high | xhigh | max
# AI_MAX_TOKENS=4096
# Model calls are billed, so each client gets a budget per minute.
# AI_RATE_LIMIT_PER_MINUTE=20

# ── The live Excel books ────────────────────────────────────────────────────
# Full path to each workbook. The server reads them; the app syncs from them
# and shows when each file last changed. Restart after changing a path.
EXCEL_ACTIVE_PAYMENTS_PATH=
EXCEL_OVERDUE_PAYMENTS_PATH=

# Which tab to read. Left out, each module picks the tab whose columns it
# recognises, so naming them is only insurance against an ambiguous file.
# EXCEL_ACTIVE_PAYMENTS_SHEET=
# EXCEL_OVERDUE_PAYMENTS_SHEET=

# ── One file holding both books ─────────────────────────────────────────────
# Keeping both in a single workbook, one tab each, is the same settings with
# the same path twice and a tab named for each:
#
#   EXCEL_ACTIVE_PAYMENTS_PATH=C:\Users\np133\Downloads\CRM Book.xlsx
#   EXCEL_ACTIVE_PAYMENTS_SHEET=CRM ACTIVE PAYMENT
#   EXCEL_OVERDUE_PAYMENTS_PATH=C:\Users\np133\Downloads\CRM Book.xlsx
#   EXCEL_OVERDUE_PAYMENTS_SHEET=CRM OverDue
#
# No quotes are needed around a path or a tab name that contains spaces, and
# the tab name is matched ignoring case and extra spaces.

# ── Signing in ──────────────────────────────────────────────────────────────
# Accounts and password hashes live on this machine, in .crm-auth/ by default.
# The team's existing usernames and passwords are carried over the first time
# the server starts; after that they are changed in the Admin Panel.
# AUTH_DIR=.crm-auth
# A session lasts this many hours of not being used.
# SESSION_HOURS=12
# Set a secret to keep everyone signed in across a move to another machine.
# Without one the server makes its own and keeps it in AUTH_DIR; deleting that
# file signs everybody out.
# AUTH_SECRET=

# ── Weekly KPI ──────────────────────────────────────────────────────────────
# Saved Overdue days and weekly scores are kept on this machine's disk, three
# months, then removed. Left out, they go in .crm-snapshots/ beside the app.
# SNAPSHOT_DIR=.crm-snapshots
